  function dreStatus(msg, ok){
    const el = $('dreStatus');
    el.className = 'dre-status show ' + (ok?'ok':'err');
    el.innerHTML = msg;
  }

  function processDreText(raw){
    const lines = raw.split(/\r?\n/);
    const rows = [];
    for(const line of lines){
      const p = parseLine(line);
      if(!p || p.value===0) continue;
      rows.push({label:p.label, value:p.value, cat: classify(p.label)});
      if(rows.length>=250) break;
    }
    if(!rows.length){
      dreStatus('⚠️ Não conseguimos identificar linhas com valores nessa DRE. Verifique o formato (uma linha por conta, com o valor ao final) ou tente colar o texto diretamente.', false);
      dreRowsData = [];
      $('drePreview').style.display='none';
      return;
    }
    dreRowsData = rows;
    const found = rows.filter(r=>r.cat!=='UNK' && r.cat!=='IGNORE').length;
    dreStatus('✅ '+rows.length+' linha(s) lida(s), '+found+' classificada(s) automaticamente nas categorias do simulador. Revise a tabela abaixo antes de aplicar.', true);
    renderDrePreview();
  }

  function readAsText(file){
    return new Promise((resolve,reject)=>{
      const fr = new FileReader();
      fr.onload = ()=>resolve(fr.result);
      fr.onerror = reject;
      fr.readAsText(file, 'utf-8');
    });
  }
  function readAsArrayBuffer(file){
    return new Promise((resolve,reject)=>{
      const fr = new FileReader();
      fr.onload = ()=>resolve(fr.result);
      fr.onerror = reject;
      fr.readAsArrayBuffer(file);
    });
  }

  let dreFileHandle = null;
  $('dreDrop').addEventListener('click', ()=> $('dreFile').click());
  $('dreDrop').addEventListener('dragover', e=>{ e.preventDefault(); $('dreDrop').classList.add('drag'); });
  $('dreDrop').addEventListener('dragleave', ()=> $('dreDrop').classList.remove('drag'));
  $('dreDrop').addEventListener('drop', e=>{
    e.preventDefault(); $('dreDrop').classList.remove('drag');
    if(e.dataTransfer.files.length){ dreFileHandle = e.dataTransfer.files[0]; $('dreFilename').textContent = '📄 '+dreFileHandle.name; }
  });
  $('dreFile').addEventListener('change', ()=>{
    if($('dreFile').files.length){ dreFileHandle = $('dreFile').files[0]; $('dreFilename').textContent = '📄 '+dreFileHandle.name; }
  });

  $('dreRead').addEventListener('click', async ()=>{
    $('dreRead').disabled = true; $('dreRead').textContent='Lendo…';
    try{
      let text = $('drePaste').value.trim();
      if(dreFileHandle && !text){
        const name = dreFileHandle.name.toLowerCase();
        if(name.endsWith('.xlsx') || name.endsWith('.xls')){
          if(typeof XLSX==='undefined'){
            dreStatus('⚠️ Não foi possível carregar o leitor de planilhas (sem conexão com a internet). Exporte a DRE como .csv ou .txt, ou cole o texto no campo acima.', false);
            return;
          }
          const buf = await readAsArrayBuffer(dreFileHandle);
          const wb = XLSX.read(buf, {type:'array'});
          const sheet = wb.Sheets[wb.SheetNames[0]];
          text = XLSX.utils.sheet_to_csv(sheet, {FS:';'});
        } else if(name.endsWith('.pdf')){
          if(typeof pdfjsLib==='undefined'){
            dreStatus('⚠️ Não foi possível carregar o leitor de PDF (sem conexão com a internet). Exporte a DRE como .csv/.txt, ou cole o texto no campo acima.', false);
            return;
          }
          pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
          const buf = await readAsArrayBuffer(dreFileHandle);
          const pdf = await pdfjsLib.getDocument({data:buf}).promise;
          let pages = [];
          for(let i=1;i<=pdf.numPages;i++){
            const page = await pdf.getPage(i);
            const content = await page.getTextContent();
            // Agrupa por linha, aproximando pela posição vertical (y) de cada item.
            const lines = {};
            content.items.forEach(it=>{
              const y = Math.round(it.transform[5]);
              (lines[y] = lines[y]||[]).push(it.str);
            });
            const ys = Object.keys(lines).map(Number).sort((a,b)=>b-a);
            pages.push(ys.map(y=>lines[y].join(' ')).join('\n'));
          }
          text = pages.join('\n');
        } else if(name.endsWith('.docx')){
          if(typeof mammoth==='undefined'){
            dreStatus('⚠️ Não foi possível carregar o leitor de Word (sem conexão com a internet). Exporte a DRE como .csv/.txt/.pdf, ou cole o texto no campo acima.', false);
            return;
          }
          const buf = await readAsArrayBuffer(dreFileHandle);
          const res = await mammoth.extractRawText({arrayBuffer:buf});
          text = res.value;
        } else if(name.endsWith('.doc')){
          dreStatus('⚠️ O formato .doc antigo não é suportado. Salve o arquivo como .docx, .pdf ou .csv e tente novamente.', false);
          return;
        } else {
          text = await readAsText(dreFileHandle);
        }
      }
      if(!text){
        dreStatus('⚠️ Anexe um arquivo ou cole o texto da DRE antes de ler.', false);
        return;
      }
      processDreText(text);
    } catch(err){
      dreStatus('⚠️ Não foi possível ler esse arquivo. Tente exportar como .csv/.txt/.pdf ou cole o texto diretamente.', false);
    } finally {
      $('dreRead').disabled = false; $('dreRead').textContent='🔎 Ler DRE';
    }
  });

  document.querySelectorAll('input[name="drePeriodo"]').forEach(r=>r.addEventListener('change', renderDreSums));

  $('dreClear').addEventListener('click', ()=>{
    dreRowsData = []; dreFileHandle = null;
    $('dreFile').value=''; $('drePaste').value=''; $('dreFilename').textContent='';
    $('drePreview').style.display='none';
    $('dreStatus').className='dre-status';
  });

  $('dreApply').addEventListener('click', ()=>{
    const anual = document.querySelector('input[name="drePeriodo"]:checked').value==='anual';
    const k = anual ? 1/12 : 1;
    $('R').value  = Math.round(dreSumOf('R')*k);
    $('Cc').value = Math.round(dreSumOf('CC')*k);
    $('Fp').value = Math.round(dreSumOf('FP')*k);
    $('PL').value = Math.round(dreSumOf('PL')*k);
    $('Cs').value = Math.round(dreSumOf('CS')*k);
    $('dreAppliedNote').style.display='block';
    document.querySelector('.tabbtn[data-tab="manual"]').click();
    dataSource = 'dre';
    compute();
    openDashboard();
  });

  $('ctaResult').addEventListener('click', ()=>{
    compute();
    openDashboard();
  });
  $('dashPrint').addEventListener('click', ()=> window.print());

  /* ---------- DASHBOARD: outra interface para o resultado da DRE ---------- */
  function donutSVG(segments){
    const r=74, cx=100, cy=100, sw=26;
    const circumference = 2*Math.PI*r;
    const total = segments.reduce((s,x)=>s+Math.max(0,x.value),0) || 1;
    let offset=0, svg='';
    segments.forEach(seg=>{
      const val=Math.max(0,seg.value);
      const frac = val/total;
      const len = frac*circumference;
      svg += '<circle cx="'+cx+'" cy="'+cy+'" r="'+r+'" fill="none" stroke="'+seg.color+'" stroke-width="'+sw+
        '" stroke-dasharray="'+len+' '+(circumference-len)+'" stroke-dashoffset="'+(-offset)+
        '" transform="rotate(-90 '+cx+' '+cy+')"/>';
      offset += len;
    });
    svg += '<circle cx="'+cx+'" cy="'+cy+'" r="'+(r-sw/2-5)+'" fill="#1C1C20"/>';
    svg += '<text x="'+cx+'" y="'+(cy-3)+'" text-anchor="middle" fill="#fff" font-size="12.5" font-weight="800">Receita</text>';
    svg += '<text x="'+cx+'" y="'+(cy+15)+'" text-anchor="middle" fill="#A9ACB3" font-size="10.5">100%</text>';
    return svg;
  }

  function openDashboard(){
    if(!lastCompute){ compute(); }
    const {e, rows, best, hojeTot, refSame, dSame} = lastCompute;
    const R = e.R || 1;
    const regimeName = REGS.find(r=>r.id===regime).n;
    const llRef = e.R-e.Cc-e.Fp-e.PL-e.Cs-refSame;
    const llBest = e.R-e.Cc-e.Fp-e.PL-e.Cs-best.o.tot;

    const origem = dataSource==='dre' ? 'dados importados da DRE' : 'dados informados manualmente';
    $('dashKick').textContent = 'Dashboard · resultado da sua carga tributária';
    $('dashSub').textContent = act.n+' · regime atual: '+regimeName+' · '+origem;

    // KPIs
    const dColor = dSame>0 ? '#C1524A' : '#34A57C';
    $('dashKpis').innerHTML =
      '<div class="dcard tilt"><div class="dl">Faturamento</div><div class="dv">'+f(e.R)+'</div><div class="ds3">receita mensal</div></div>'+
      '<div class="dcard tilt"><div class="dl">Carga hoje</div><div class="dv">'+f(hojeTot)+'</div><div class="ds3">'+pc(hojeTot/R*100)+' da receita</div></div>'+
      '<div class="dcard tilt"><div class="dl">Carga na reforma</div><div class="dv" style="color:'+dColor+'">'+f(refSame)+'</div><div class="ds3">'+(dSame>0?'+':'')+f(dSame)+'/mês vs. hoje</div></div>'+
      '<div class="dcard tilt"><div class="dl">Lucro líquido (melhor regime)</div><div class="dv" style="color:#34A57C">'+f(llBest)+'</div><div class="ds3">com '+best.n+'</div></div>';

    // Donut: composição da DRE
    const segs = [
      {label:'Compras c/ crédito', value:e.Cc, color:'var(--violet)'},
      {label:'Folha', value:e.Fp, color:'var(--amber)'},
      {label:'Pró-labore', value:e.PL, color:'var(--coral)'},
      {label:'Outros custos', value:e.Cs, color:'var(--teal)'},
      {label:'Carga tributária (reforma)', value:refSame, color:'var(--cyan)'},
      {label:'Lucro líquido', value:Math.max(0,llRef), color:'var(--green)'},
    ];
    $('dashDonut').innerHTML = donutSVG(segs);
    $('dashLegend').innerHTML = segs.map(s=>
      '<div class="li"><span class="sw" style="background:'+s.color+'"></span>'+s.label+'<span class="lv">'+pc(Math.max(0,s.value)/R*100)+'</span></div>'
    ).join('');

    // Barras: carga por regime na reforma
    const maxTot = Math.max.apply(null, rows.map(r=>r.o.tot));
    const barColors = {simples:'var(--violet)', hibrido:'var(--amber)', presumido:'var(--teal)', real:'var(--cyan)'};
    $('dashBars').innerHTML = rows.map(r=>{
      const w = Math.max(8, r.o.tot/maxTot*100);
      const isBest = r.id===best.id;
      const col = isBest ? 'var(--green)' : barColors[r.id];
      return '<div class="drow"><div class="dn"><span>'+r.n+(isBest?' ✓ menor carga':'')+'</span><b>'+f(r.o.tot)+'</b></div>'+
        '<div class="dt"><div class="df" style="width:'+w+'%;background:'+col+'">'+pc(r.o.tot/R*100)+'</div></div></div>';
    }).join('');

    // Barras: hoje x reforma
    const maxHR = Math.max(hojeTot, refSame);
    $('dashCompare').innerHTML =
      '<div class="drow"><div class="dn"><span>Hoje ('+regimeName+')</span><b>'+f(hojeTot)+'</b></div>'+
      '<div class="dt"><div class="df" style="width:'+Math.max(8,hojeTot/maxHR*100)+'%;background:var(--amber)">'+pc(hojeTot/R*100)+'</div></div></div>'+
      '<div class="drow"><div class="dn"><span>Reforma, mesmo regime</span><b>'+f(refSame)+'</b></div>'+
      '<div class="dt"><div class="df" style="width:'+Math.max(8,refSame/maxHR*100)+'%;background:'+dColor+'">'+pc(refSame/R*100)+'</div></div></div>';

    $('dashNote').innerHTML = dSame>0
      ? 'Com os '+origem+', mantido o regime atual ('+regimeName+'), a carga tributária tende a subir '+f(dSame)+' por mês na reforma. Avalie o regime de menor carga ('+best.n+') na aba de resultado detalhado.'
      : 'Com os '+origem+', mantido o regime atual ('+regimeName+'), a carga tributária tende a cair '+f(Math.abs(dSame))+' por mês na reforma.';

    $('dashOverlay').classList.add('on');
    document.body.style.overflow='hidden';
  }

  function closeDashboard(){
    $('dashOverlay').classList.remove('on');
    document.body.style.overflow='';
  }
  $('dashClose').addEventListener('click', closeDashboard);
  $('dashOverlay').addEventListener('keydown', e=>{ if(e.key==='Escape') closeDashboard(); });

  /* ---------- EFEITO 3D AO PASSAR O CURSOR ---------- */
  // Delegado no document: funciona mesmo com elementos recriados a cada render.
  const TILT_MAX = 9;       // graus de rotação máxima
  let tiltCurrent = null;

  function resetTilt(el){
    el.style.transform = '';
  }

  function applyTilt(el, clientX, clientY){
    const r = el.getBoundingClientRect();
    if(r.width===0 || r.height===0) return;
    const px = (clientX - r.left) / r.width;   // 0..1
    const py = (clientY - r.top) / r.height;   // 0..1
    const rotY = (px - 0.5) * TILT_MAX * 2;
    const rotX = (0.5 - py) * TILT_MAX * 2;
    el.style.transform = 'perspective(900px) rotateX('+rotX.toFixed(2)+'deg) rotateY('+rotY.toFixed(2)+'deg) translateZ(4px)';
    el.style.setProperty('--mx', (px*100).toFixed(1)+'%');
    el.style.setProperty('--my', (py*100).toFixed(1)+'%');
  }

  document.addEventListener('pointermove', e=>{
    if(e.pointerType==='touch') return;
    const el = e.target.closest('.tilt');
    if(el !== tiltCurrent){
      if(tiltCurrent) resetTilt(tiltCurrent);
      tiltCurrent = el;
    }
    if(el) applyTilt(el, e.clientX, e.clientY);
  }, {passive:true});

  document.documentElement.addEventListener('mouseleave', ()=>{
    if(tiltCurrent){ resetTilt(tiltCurrent); tiltCurrent=null; }
  });

  // Ao rolar, o alvo pode sumir da tela sem disparar mouseleave.
  window.addEventListener('scroll', ()=>{ if(tiltCurrent){ resetTilt(tiltCurrent); tiltCurrent=null; } }, {passive:true, capture:true});
})();
</script>
