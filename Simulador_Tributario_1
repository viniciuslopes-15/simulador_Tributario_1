    {id:'rest', n:'Restaurante / Bar', d:'Alimentação', op:'com', red:1, pub:'b2c', R:80000, Cc:32000, Fp:20000, PL:8000, Cs:12000, sdas:10.5},
    {id:'agro', n:'Produtor rural / Agro', d:'Grãos, pecuária, insumos', op:'com', red:0.4, pub:'b2b', R:400000, Cc:220000, Fp:60000, PL:15000, Cs:40000, sdas:8},
    {id:'agroind', n:'Agroindústria', d:'Processados do agro', op:'com', red:1, pub:'b2b', R:600000, Cc:360000, Fp:110000, PL:20000, Cs:50000, sdas:11},
    {id:'cesta', n:'Cesta básica (in natura)', d:'Arroz, feijão, leite, carnes', op:'com', red:0, pub:'b2c', R:250000, Cc:170000, Fp:35000, PL:12000, Cs:25000, sdas:4},
  ];
  const REGS = [
    {id:'simples', n:'Simples Nacional', d:'Guia única (DAS)'},
    {id:'presumido', n:'Lucro Presumido', d:'Presunção de lucro'},
    {id:'real', n:'Lucro Real', d:'Lucro apurado'},
