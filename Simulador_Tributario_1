  const redName = r => r===0?'zero (cesta básica in natura)':r===0.7?'−30% (profissão intelectual)':r===0.4?'−60% (setor essencial: saúde, educação, agro)':'cheia';
  const redTag  = r => r===1?'Alíquota cheia':(r===0?'Alíquota zero':(r===0.7?'Redução 30%':'Redução 60%'));
  const redColor= r => r===1?'var(--navy2)':'var(--green)';
  const presDefault = op => op==='serv' ? {i:32, c:32} : {i:8, c:12};

  let act = ACTS[0];
  let regime = 'presumido';
  let lastCompute = null;
  let dataSource = 'manual';

  const irpj = b => 0.15*Math.max(0,b) + 0.10*Math.max(0, Math.max(0,b)-20000);
  const csll = b => 0.09*Math.max(0,b);

  function renderActs(){
    $('acts').innerHTML = ACTS.map(a=>(
      '<div class="act tilt'+(a.id===act.id?' on':'')+'" data-id="'+a.id+'"><div class="an">'+a.n+'</div>'+
      '<div class="ad">'+a.d+'</div><span class="tag" style="background:'+redColor(a.red)+'">'+redTag(a.red)+'</span></div>'
    )).join('');
    $('acts').querySelectorAll('.act').forEach(el=>el.onclick=()=>{ act=ACTS.find(x=>x.id===el.dataset.id);
      fillActivity(); renderActs(); compute(); });
  }
  function renderRegs(){
    $('regs').innerHTML = REGS.map(r=>(
      '<div class="reg tilt'+(r.id===regime?' on':'')+'" data-id="'+r.id+'"><div class="rn">'+r.n+'</div><div class="rd">'+r.d+'</div></div>'
    )).join('');
    $('regs').querySelectorAll('.reg').forEach(el=>el.onclick=()=>{ regime=el.dataset.id; renderRegs(); compute(); });
  }
  function fillActivity(){
    $('R').value=act.R; $('Cc').value=act.Cc; $('Fp').value=act.Fp; $('PL').value=act.PL; $('Cs').value=act.Cs; $('sdas').value=act.sdas;
    const p=presDefault(act.op); $('presI').value=p.i; $('presC').value=p.c;
  }
  const num = id => parseFloat($(id).value)||0;

  function engine(){
    const op=act.op, R=num('R'), Cc=num('Cc'), Fp=num('Fp'), PL=num('PL'), Cs=num('Cs');
    const tRef=(num('tref')/100)*act.red;
    const pcCum=num('pcCum')/100, pcNao=num('pcNao')/100, icms=num('icms')/100, iss=num('iss')/100;
    const cppR=num('cpp')/100, patR=num('patpl')/100, segR=num('segpl')/100, teto=num('teto');
    const presI=num('presI')/100, presC=num('presC')/100, shareDAS=num('shareDAS')/100, sDAS=num('sdas')/100;

    const consRef=Math.max(0, tRef*(R-Cc));
    const cppFolha=Fp*cppR;
    const seg = segR*Math.min(PL, teto);     // INSS segurado do sócio (com teto)
    const patPL = patR*PL;                    // INSS patronal sobre pró-labore
    const inssReg = seg + patPL;              // Presumido/Real
    const inssSimples = seg;                  // Simples: patronal está no DAS

    const consPresH = op==='serv' ? R*pcCum + R*iss : R*pcCum + (R-Cc)*icms;
    const consRealH = op==='serv' ? (R-Cc)*pcNao + R*iss : (R-Cc)*pcNao + (R-Cc)*icms;

    // PRESUMIDO (majoração de 10% na base IRPJ/CSLL acima do limite anual)
    const limiteMaj=num('limiteMaj'), majPct=num('majPct')/100;
    const majAtiva = (R*12) > limiteMaj;
    const majFactor = majAtiva ? (1+majPct) : 1;
    const preI=irpj(presI*R*majFactor), preC=csll(presC*R*majFactor);
    const pres = {
      hoje:{cons:consPresH, irpj:preI, csll:preC, cpp:cppFolha, inss:inssReg},
      ref: {cons:consRef,   irpj:preI, csll:preC, cpp:cppFolha, inss:inssReg}
    };
    // REAL: IRPJ/CSLL sobre o lucro apurado.
    // HOJE: os tributos sobre consumo ("por dentro") reduzem a receita → reduzem a base.
    // REFORMA: o IBS/CBS é "por fora" (não é receita nem despesa) → não reduz o lucro.
    const luH = R - consRealH - Cc - Fp - Cs - PL - cppFolha - patPL;
    const luR = R - Cc - Fp - Cs - PL - cppFolha - patPL;
    const real = {
      hoje:{cons:consRealH, irpj:irpj(luH), csll:csll(luH), cpp:cppFolha, inss:inssReg},
      ref: {cons:consRef,   irpj:irpj(luR), csll:csll(luR), cpp:cppFolha, inss:inssReg}
    };
    const tot = o => o.cons+o.irpj+o.csll+o.cpp+o.inss;
    pres.hoje.tot=tot(pres.hoje); pres.ref.tot=tot(pres.ref);
    real.hoje.tot=tot(real.hoje); real.ref.tot=tot(real.ref);

    const das=sDAS*R;
    const simTrad={cons:'DAS', irpj:'DAS', csll:'DAS', cpp:'DAS', inss:inssSimples, das, tot:das+inssSimples, creditoCliente:0.20*consRef};
    const simHib ={cons:consRef, irpj:'DAS', csll:'DAS', cpp:'DAS', inss:inssSimples, tot:das*(1-shareDAS)+consRef+inssSimples, creditoCliente:tRef*R};

    return {op,R,Cc,Fp,PL,Cs,tRef,seg,patPL,inssSimples,consRef,cppFolha,luH,luR,majAtiva,majPct,pres,real,simTrad,simHib};
  }

