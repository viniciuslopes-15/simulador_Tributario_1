<script>
(function(){
  const $ = id => document.getElementById(id);
  const BRL = new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL',maximumFractionDigits:0});
  const f = v => BRL.format(Math.round(v));
  const pc = v => v.toFixed(1).replace('.',',')+'%';

  const ACTS = [
    {id:'contador', n:'Contador', d:'Contabilidade', op:'serv', red:0.7, pub:'b2b', R:30000, Cc:4000, Fp:8000, PL:5000, Cs:4000, sdas:16},
