  /* ---------- IMPORTAÇÃO DE DRE ---------- */
  const norm = s => (s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();

  const CATS = {
    R:  {label:'Receita / Faturamento', kw:['receita bruta','receita operacional bruta','faturamento','receita de vendas','vendas brutas','receita bruta de vendas','receita bruta de servicos','receita bruta de servico','receita total']},
