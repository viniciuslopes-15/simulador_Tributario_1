    IGNORE: {label:'Ignorar (tributo/resultado)', kw:['icms','pis ','pis/cofins','cofins','iss ','irpj','csll','ir sobre','contribuicao social','deducoes','impostos sobre venda','imposto sobre venda','lucro bruto','lucro liquido','lucro operacional','resultado bruto','resultado liquido','resultado operacional','resultado antes','ebitda','receita liquida','despesas tributarias','simples nacional','das (','demonstracao do resultado','dre ']}
  };
  const CAT_ORDER = ['IGNORE','R','CC','PL','FP','CS'];

  function classify(label){
    const n = norm(label);
    for(const key of CAT_ORDER){
      if(CATS[key].kw.some(k=>n.includes(k))) return key;
    }
    return 'UNK';
  }

  function toNumberBR(tokRaw){
    if(tokRaw==null) return null;
    let tok = String(tokRaw).replace(/[R$\s]/g,'');
    if(tok==='') return null;
    const neg = /^\(.*\)$/.test(tok) || tok.startsWith('-');
    tok = tok.replace(/[()]/g,'').replace(/^-/,'');
    if(/,\d{1,2}$/.test(tok)) tok = tok.replace(/\./g,'').replace(',','.');
    else tok = tok.replace(/,/g,'');
    const v = parseFloat(tok);
    if(isNaN(v)) return null;
    return neg ? -v : v;
  }

  function parseLine(line){
    line = line.replace(/\u00A0/g,' ').trim();
    if(!line) return null;
    const cells = line.split(/;|\t/).map(c=>c.trim()).filter(c=>c!=='');
    if(cells.length>=2){
      for(let i=cells.length-1;i>=1;i--){
        const v = toNumberBR(cells[i]);
        if(v!==null) return {label:cells[0], value:Math.abs(v)};
      }
    }
    const matches = line.match(/-?\(?\s*\d{1,3}(?:[.\s]\d{3})*(?:,\d{1,2})?\)?/g);
    if(!matches || !matches.length) return null;
    const lastTok = matches[matches.length-1];
    const v = toNumberBR(lastTok);
    if(v===null) return null;
    const idx = line.lastIndexOf(lastTok);
    const label = line.slice(0, idx).replace(/[.\-–—:\s]+$/,'').trim();
    return {label: label || line, value: Math.abs(v)};
  }

  let dreRowsData = [];

  function renderDrePreview(){
