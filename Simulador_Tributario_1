<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Simulador Tributário · Reforma Tributária</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0B0B0D; --navy2:#1D1D21; --cyan:#A6ABB5; --teal:#4A5568;
    --amber:#8A8680; --coral:#7A2331; --green:#1F5C46; --violet:#3E4A5E;
    --ice:#E8E9EC; --ink:#17171A; --muted:#6B6D72; --line:#DCDCDF; --light:#F2F2F4;
    --gold-rgb:168,174,184; --shadow-rgb:10,10,12;
    --silver-grad:linear-gradient(115deg,#6E7278 0%,#E9EAED 20%,#FFFFFF 32%,#9296A0 46%,#F4F5F6 60%,#787C84 74%,#DBDCE0 88%,#AEB1B8 100%);
    --font-display:'Fraunces',Georgia,'Times New Roman',serif;
    --font-mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Inter','Segoe UI',Calibri,system-ui,Arial,sans-serif;background:#EAEAEC;color:var(--ink);
       background-image:radial-gradient(1100px 700px at 15% -10%, #FAFAFB 0%, #EAEAEC 55%);
       -webkit-font-smoothing:antialiased;padding:24px 14px;}
  .wrap{max-width:1060px;margin:0 auto;}
  .app{background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 18px 50px rgba(var(--shadow-rgb),.22);}
  .top{background:var(--navy);color:#fff;padding:22px 30px;position:relative;overflow:hidden;border-bottom:1px solid rgba(var(--gold-rgb),.35);}
  .top:after{content:'';position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(420px 260px at 88% -20%, rgba(255,255,255,.16), transparent 70%);}
  .top:before{content:'';position:absolute;inset:0;pointer-events:none;opacity:.5;
    background-image:linear-gradient(rgba(var(--gold-rgb),.14) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--gold-rgb),.14) 1px,transparent 1px);
    background-size:26px 26px;mask-image:radial-gradient(ellipse 100% 100% at 70% 0%, #000 30%, transparent 75%);
    animation:gridshift 18s linear infinite;}
  @keyframes gridshift{from{background-position:0 0,0 0}to{background-position:52px 26px,26px 52px}}
  .top .rings{position:absolute;right:-60px;top:-60px;width:240px;height:240px;opacity:.5;animation:spin 40s linear infinite;}
  @keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
  .top .pulse{position:absolute;right:96px;top:56px;width:8px;height:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 0 rgba(var(--gold-rgb),.7);animation:pulse 2.2s ease-out infinite;}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(var(--gold-rgb),.55)}70%{box-shadow:0 0 0 14px rgba(var(--gold-rgb),0)}100%{box-shadow:0 0 0 0 rgba(var(--gold-rgb),0)}}
  .metal-text{background:var(--silver-grad);background-size:220% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:metalShine 6s linear infinite;}
  @keyframes metalShine{0%{background-position:0% 50%}100%{background-position:220% 50%}}
  h1,.dph,.ph,.ph2,.ct,.dk,.hl .ht{font-family:var(--font-display);font-weight:600;letter-spacing:.2px;}
  .app,.dash-overlay{position:relative;}
  .kick{color:var(--cyan);font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;}
  .top h1{font-size:25px;margin-top:4px;font-weight:800;}
  .top h1 span{background:var(--silver-grad);background-size:220% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:metalShine 6s linear infinite;}
  .top p{color:var(--ice);font-size:13.5px;margin-top:4px;max-width:730px;}
  .pad{padding:24px 30px 32px;}
  .step{display:flex;align-items:center;gap:10px;margin:22px 0 12px;}
  .step:first-child{margin-top:4px;}
  .step .sn{width:30px;height:30px;border-radius:50%;background:var(--navy);color:var(--cyan);font-weight:800;
            display:flex;align-items:center;justify-content:center;font-size:15px;flex:none;}
  .step .st{font-size:16px;font-weight:800;}
  .step .sd{font-size:12.5px;color:var(--muted);}
  .acts{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;}
  .act{border:1.5px solid var(--line);border-radius:12px;padding:12px;cursor:pointer;transition:transform .15s ease-out,box-shadow .15s ease-out,border-color .15s;background:#fff;position:relative;overflow:hidden;}
  .act:hover{border-color:var(--cyan);box-shadow:0 14px 24px -10px rgba(var(--shadow-rgb),.28),0 0 0 1px rgba(var(--gold-rgb),.25);}
  .act.on{border-color:var(--cyan);background:#F0F1F3;box-shadow:inset 0 0 0 1.5px var(--cyan),0 0 16px rgba(var(--gold-rgb),.35);}
  .act .an{font-size:14px;font-weight:700;}
  .act .ad{font-size:11.5px;color:var(--muted);margin-top:3px;line-height:1.3;}
  .act .tag{display:inline-block;font-size:10px;font-weight:800;padding:1px 7px;border-radius:999px;margin-top:6px;color:#fff;}
  .regs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
  @media(max-width:560px){.regs{grid-template-columns:1fr}}
  .reg{border:1.5px solid var(--line);border-radius:12px;padding:13px;cursor:pointer;text-align:center;transition:transform .15s ease-out,box-shadow .15s ease-out,border-color .15s;background:#fff;position:relative;overflow:hidden;}
  .reg:hover{border-color:var(--cyan);box-shadow:0 14px 24px -10px rgba(var(--shadow-rgb),.28),0 0 0 1px rgba(var(--gold-rgb),.25);}
  .reg.on{border-color:var(--cyan);background:#F0F1F3;box-shadow:inset 0 0 0 1.5px var(--cyan),0 0 16px rgba(var(--gold-rgb),.35);}
  .reg .rn{font-size:15px;font-weight:800;}
  .reg .rd{font-size:11.5px;color:var(--muted);margin-top:3px;line-height:1.3;}
  .nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:11px;}
  .fld label{display:block;font-size:11px;font-weight:700;color:var(--navy2);margin-bottom:5px;}
  .fld input,.fld select{width:100%;border:1.5px solid var(--line);border-radius:9px;padding:9px 10px;font-size:13.5px;font-family:inherit;color:var(--ink);background:#fff;}
  .fld input:focus,.fld select:focus{outline:none;border-color:var(--cyan);}
  .fld .sub{font-size:10px;color:var(--muted);margin-top:3px;}
  .adv{margin-top:14px;border-top:1px dashed var(--line);padding-top:12px;}
  .adv summary{cursor:pointer;font-size:12.5px;font-weight:700;color:var(--cyan);}
  .adv .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:12px;}
  .adv .fld label{font-weight:600;color:var(--muted);}
  .hl{border-radius:14px;padding:18px 20px;color:#fff;margin:22px 0 16px;background:var(--navy);position:relative;overflow:hidden;transition:box-shadow .15s;}
  .hl:hover{box-shadow:0 18px 34px -16px rgba(var(--shadow-rgb),.5);}
  .hl .ht{font-size:13px;font-weight:700;color:var(--cyan);text-transform:uppercase;letter-spacing:.6px;}
  .hl .hbig{display:flex;gap:26px;flex-wrap:wrap;align-items:baseline;margin-top:8px;}
  .hl .hb{font-size:13px;color:var(--ice);}
  .hl .hb b{display:block;font-size:26px;color:#fff;font-weight:800;line-height:1.1;}
  .hl .hv{font-size:14px;font-weight:800;padding:6px 14px;border-radius:999px;align-self:center;}
  .panel{border:1.5px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:16px;transition:transform .15s ease-out,box-shadow .15s ease-out;position:relative;overflow:hidden;}
  .panel:hover{box-shadow:0 16px 30px -14px rgba(var(--shadow-rgb),.22);}
  .panel .ph{font-size:14px;font-weight:800;margin-bottom:12px;}
  .scroll{overflow-x:auto;}
  table.cmp{width:100%;border-collapse:collapse;font-size:12.5px;min-width:640px;}
  table.cmp th,table.cmp td{padding:9px 6px;text-align:right;border-bottom:1px solid var(--line);}
  table.cmp th:first-child,table.cmp td:first-child{text-align:left;}
  table.cmp thead th{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.2px;}
  table.cmp tbody tr{transition:background .12s;}
  table.cmp tbody tr:hover{background:#F2F3F5;}
  table.cmp tr.best{background:#E7ECEA;}
  table.cmp tr.best td:first-child{font-weight:800;color:#1F5C46;}
  table.cmp td.tot{font-weight:800;color:var(--navy);font-family:var(--font-mono);}
  table.cmp .sub{font-size:10px;color:var(--muted);font-weight:600;}
  /* bar chart */
  .bars{margin-top:4px;}
  .brow{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
  .brow .bn{width:150px;flex:none;font-size:12.5px;font-weight:700;}
  .brow .bn .s{display:block;font-size:10.5px;color:var(--muted);font-weight:600;}
  .brow .bt{flex:1;height:26px;background:var(--light);border-radius:7px;overflow:hidden;}
  .brow .bf{height:100%;border-radius:7px;display:flex;align-items:center;justify-content:flex-end;padding-right:9px;color:#fff;font-size:12px;font-weight:800;font-family:var(--font-mono);min-width:52px;transition:width .7s cubic-bezier(.16,1,.3,1);position:relative;overflow:hidden;}
  .brow .bf:after{content:'';position:absolute;inset:0;background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.35) 50%,transparent 70%);background-size:200% 100%;animation:shimmer 2.4s ease-in-out infinite;}
  @keyframes shimmer{0%{background-position:160% 0}100%{background-position:-60% 0}}
  .calc{border:1.5px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:16px;background:var(--light);transition:box-shadow .15s;position:relative;overflow:hidden;}
  .calc:hover{box-shadow:0 16px 30px -14px rgba(var(--shadow-rgb),.18);}
  .calc .ct{font-size:13px;font-weight:800;margin-bottom:10px;}
  .calc .line{display:flex;justify-content:space-between;font-size:13px;padding:6px 0;border-bottom:1px dashed var(--line);}
  .calc .line:last-child{border-bottom:0;}
  .calc .line.tot{font-weight:800;font-size:15px;color:var(--navy);border-top:2px solid var(--navy);margin-top:2px;padding-top:9px;font-family:var(--font-mono);}
  .calc .op{color:var(--muted);font-weight:700;}
  .kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
  @media(max-width:560px){.kpis{grid-template-columns:1fr}}
  .kpi{background:var(--light);border-radius:11px;padding:12px;transition:transform .15s ease-out,box-shadow .15s ease-out,background .15s;position:relative;overflow:hidden;}
  .kpi:hover{background:#fff;box-shadow:0 14px 26px -12px rgba(var(--shadow-rgb),.25),0 0 0 1px rgba(var(--gold-rgb),.2);}
  .kpi .l{font-size:11px;color:var(--muted);font-weight:700;}
  .kpi .v{font-size:20px;font-weight:800;margin-top:3px;font-family:var(--font-mono);}
  .kpi .s{font-size:11px;color:var(--muted);margin-top:2px;}
  .note{font-size:12.5px;color:var(--muted);line-height:1.5;margin-top:12px;background:var(--light);border-radius:10px;padding:11px 13px;}
  .note b{color:var(--ink);}
  .warn{font-size:12px;color:#8a5a00;background:#FBF1DC;border-radius:10px;padding:11px 13px;margin-top:14px;line-height:1.45;}
  .foot{margin-top:16px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
  .foot small{color:var(--muted);font-size:12px;}
  .btn{appearance:none;border:0;cursor:pointer;font-weight:700;font-family:inherit;border-radius:999px;padding:11px 20px;font-size:14px;transition:transform .15s ease-out,box-shadow .15s ease-out,background .15s;position:relative;}
  .btn:hover{transform:translateY(-2px);}
  .btn:active{transform:translateY(0);}
  .btn-ghost{background:transparent;color:var(--navy);border:1.5px solid var(--line);}
  .btn-ghost:hover{border-color:var(--cyan);box-shadow:0 10px 20px -10px rgba(var(--shadow-rgb),.3);}
  .btn-primary{background:linear-gradient(155deg,#232327 0%,#0B0B0D 55%,#1B1B1F 100%);color:#fff;border:1px solid rgba(var(--gold-rgb),.4);box-shadow:0 8px 20px -8px rgba(var(--shadow-rgb),.5),inset 0 1px 0 rgba(255,255,255,.12);position:relative;overflow:hidden;}
  .btn-primary:before{content:'';position:absolute;inset:0;background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.22) 50%,transparent 70%);background-size:220% 100%;background-position:160% 0;transition:background-position .6s ease;}
  .btn-primary:hover:before{background-position:-60% 0;}
  .btn-primary:hover{background:linear-gradient(155deg,#2C2C31 0%,#0F0F12 55%,#232327 100%);box-shadow:0 14px 28px -10px rgba(var(--gold-rgb),.55),0 0 0 1px rgba(var(--gold-rgb),.4);}
  .btn-primary:disabled{opacity:.45;cursor:not-allowed;background:var(--navy);transform:none;box-shadow:none;}
  .btn-sm{padding:8px 14px;font-size:12.5px;}
  #ctaResult{animation:ctaGlow 2.6s ease-in-out infinite;}
  @keyframes ctaGlow{0%,100%{box-shadow:0 8px 20px -8px rgba(var(--shadow-rgb),.5)}50%{box-shadow:0 10px 26px -6px rgba(var(--gold-rgb),.65),0 0 0 4px rgba(var(--gold-rgb),.12)}}

  /* tabs */
  .tabs{display:flex;gap:4px;margin-bottom:14px;border-bottom:1.5px solid var(--line);}
  .tabbtn{appearance:none;background:none;border:0;padding:10px 6px;font-size:13px;font-weight:700;color:var(--muted);cursor:pointer;border-bottom:2.5px solid transparent;margin-bottom:-1.5px;font-family:inherit;transition:.12s;}
  .tabbtn.on{color:var(--navy);border-bottom-color:var(--cyan);}
  .tabbtn:hover{color:var(--navy);}
  .tabpanel{display:none;}
  .tabpanel.on{display:block;animation:fadein .18s ease;}
  @keyframes fadein{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:none}}

  /* DRE import */
  .dre-drop{border:2px dashed var(--line);border-radius:12px;padding:26px 16px;text-align:center;cursor:pointer;transition:.12s;background:var(--light);}
  .dre-drop:hover,.dre-drop.drag{border-color:var(--cyan);background:#F0F1F3;}
  .dre-drop input[type=file]{display:none;}
  .dre-drop .di{font-size:26px;line-height:1;}
  .dre-drop .dt{font-size:13px;font-weight:700;color:var(--navy2);margin-top:8px;}
  .dre-drop .ds{font-size:11.5px;color:var(--muted);margin-top:3px;}
  .dre-filename{font-size:12px;font-weight:700;color:#1F5C46;margin-top:8px;}
  .dre-or{text-align:center;font-size:10.5px;color:var(--muted);font-weight:800;margin:14px 0;text-transform:uppercase;letter-spacing:.8px;}
  .dre-or:before,.dre-or:after{content:'';display:inline-block;width:60px;height:1px;background:var(--line);vertical-align:middle;margin:0 10px;}
  .dre-paste textarea{width:100%;min-height:110px;border:1.5px solid var(--line);border-radius:10px;padding:10px 12px;font-family:ui-monospace,Consolas,monospace;font-size:12px;resize:vertical;color:var(--ink);}
  .dre-paste textarea:focus{outline:none;border-color:var(--cyan);}
  .dre-opts{display:flex;align-items:center;gap:16px;margin-top:12px;flex-wrap:wrap;}
  .dre-opts .radios{display:flex;gap:14px;flex-wrap:wrap;}
  .dre-opts label{font-size:12px;font-weight:600;color:var(--navy2);display:flex;align-items:center;gap:5px;cursor:pointer;}
  .dre-status{font-size:12.5px;margin-top:12px;padding:10px 13px;border-radius:10px;display:none;line-height:1.4;}
  .dre-status.show{display:block;}
  .dre-status.ok{background:#E7ECEA;color:#1F5C46;}
  .dre-status.err{background:#F5E4E1;color:#8C2A2A;}
  .dre-preview{margin-top:16px;}
  .dre-preview .ph2{font-size:13px;font-weight:800;margin-bottom:4px;}
  .dre-preview .ps{font-size:11.5px;color:var(--muted);margin-bottom:10px;}
  table.dre-tbl{width:100%;border-collapse:collapse;font-size:12px;}
  table.dre-tbl th,table.dre-tbl td{padding:7px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle;}
  table.dre-tbl thead th{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.3px;}
  table.dre-tbl td:nth-child(2),table.dre-tbl th:nth-child(2){text-align:right;white-space:nowrap;}
  table.dre-tbl select{font-size:11.5px;border:1px solid var(--line);border-radius:6px;padding:4px 6px;font-family:inherit;background:#fff;color:var(--ink);}
  table.dre-tbl tr.ignored{opacity:.4;}
  .dre-sums{display:grid;grid-template-columns:repeat(auto-fit,minmax(118px,1fr));gap:8px;margin-top:16px;}
  .dre-sums .ds2{background:var(--light);border-radius:10px;padding:10px 11px;}
  .dre-sums .ds2 .l{font-size:9.5px;color:var(--muted);font-weight:800;text-transform:uppercase;letter-spacing:.2px;}
  .dre-sums .ds2 .v{font-size:15px;font-weight:800;color:var(--navy);margin-top:3px;}
  .dre-apply-row{display:flex;justify-content:flex-end;margin-top:14px;gap:10px;flex-wrap:wrap;}

  /* tooltip */
  .tip{position:relative;display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border-radius:50%;background:var(--line);color:var(--muted);font-size:10px;font-weight:800;cursor:help;margin-left:4px;flex:none;}
  .tip:hover .tipbox{display:block;}
  .tipbox{display:none;position:absolute;bottom:22px;left:50%;transform:translateX(-50%);background:var(--navy);color:#fff;font-size:11.5px;font-weight:500;line-height:1.4;padding:9px 11px;border-radius:8px;width:220px;z-index:20;box-shadow:0 8px 20px rgba(0,0,0,.2);}
  .tipbox:after{content:'';position:absolute;top:100%;left:50%;transform:translateX(-50%);border:6px solid transparent;border-top-color:var(--navy);}

  /* floating nav */
  .fab{position:fixed;bottom:20px;right:20px;display:flex;flex-direction:column;gap:9px;z-index:60;}
  .fab button{width:44px;height:44px;border-radius:50%;border:0;background:var(--navy);color:#fff;font-size:18px;cursor:pointer;box-shadow:0 8px 18px rgba(var(--shadow-rgb),.35);display:flex;align-items:center;justify-content:center;}
  .fab button:hover{background:var(--navy2);}
  .fab button.hide{display:none;}

  @media print{body{background:#fff;padding:0}.app{box-shadow:none}.noprint{display:none!important}.fab{display:none!important}}

  /* ---------- DASHBOARD (outra interface) ---------- */
  .dash-overlay{position:fixed;inset:0;background:radial-gradient(1200px 700px at 85% -10%, #242429 0%, #0A0A0C 55%),#0A0A0C;z-index:200;overflow-y:auto;display:none;font-family:inherit;animation:dashIn .25s ease;}
  .dash-overlay:before{content:'';position:fixed;inset:0;pointer-events:none;opacity:.35;
    background-image:linear-gradient(rgba(var(--gold-rgb),.10) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--gold-rgb),.10) 1px,transparent 1px);
    background-size:34px 34px;mask-image:radial-gradient(ellipse 70% 60% at 50% 0%, #000 20%, transparent 75%);}
  @keyframes dashIn{from{opacity:0}to{opacity:1}}
  .dash-overlay.on{display:block;}
  .dash-wrap{max-width:1080px;margin:0 auto;padding:22px 16px 60px;position:relative;}
  .dash-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;color:#fff;margin-bottom:20px;flex-wrap:wrap;}
  .dash-top .dk{color:var(--cyan);font-size:11.5px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;font-family:var(--font-mono);}
  .dash-top h2{font-size:23px;font-weight:800;margin-top:3px;font-family:var(--font-display);}
  .dash-top p{color:var(--ice);font-size:13px;margin-top:5px;max-width:640px;}
  .dash-close{background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.25);color:#fff;border-radius:999px;padding:9px 18px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;flex:none;transition:transform .15s ease-out,background .15s,box-shadow .15s;}
  .dash-close:hover{background:rgba(255,255,255,.16);transform:translateY(-2px);box-shadow:0 10px 20px -10px rgba(0,0,0,.4);}
  .dash-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px;}
  @media(max-width:760px){.dash-grid{grid-template-columns:repeat(2,1fr);}}
  .dcard{background:linear-gradient(160deg,#242429,#151517);border:1px solid #2E2E33;border-radius:14px;padding:14px 16px;position:relative;overflow:hidden;transition:transform .15s ease-out,box-shadow .15s ease-out,border-color .15s;}
  .dcard:hover{border-color:rgba(var(--gold-rgb),.5);box-shadow:0 16px 32px -14px rgba(0,0,0,.55),0 0 22px -6px rgba(var(--gold-rgb),.35);}
  .dcard .dl{font-size:10.5px;color:var(--ice);font-weight:800;text-transform:uppercase;letter-spacing:.4px;}
  .dcard .dv{font-size:21px;font-weight:800;color:#fff;margin-top:6px;line-height:1.1;font-family:var(--font-mono);}
  .dcard .ds3{font-size:11.5px;color:#A9ACB3;margin-top:4px;}
